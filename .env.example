# ── Core ──────────────────────────────────────────────────────────────
NODE_ENV=development
API_PORT=4100
PUBLIC_URL=http://localhost:4100
WEB_URL=http://localhost:5173

# Workspace resolution until Supabase auth lands: slug used when no API key provided
DEV_WORKSPACE_SLUG=harbor-ventures

# ── Postgres (local docker-compose) ───────────────────────────────────
DATABASE_URL=postgres://copyr:copyr@localhost:5433/copyr

# ── Storage (MinIO locally, S3 in prod) ───────────────────────────────
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_REGION=us-east-1
STORAGE_BUCKET=copyr-local
STORAGE_ACCESS_KEY_ID=copyr-dev
STORAGE_SECRET_ACCESS_KEY=copyr-dev-secret
STORAGE_FORCE_PATH_STYLE=true

# ── AI ────────────────────────────────────────────────────────────────
# mock | openai  (mock = deterministic, offline, free)
AI_PROVIDER=mock
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_CREDITS_MONTHLY_GRANT=500

# ── Email ingestion ───────────────────────────────────────────────────
# Shared secret for inbound webhook (Mailpit → webhook / SES → webhook)
INBOUND_WEBHOOK_SECRET=dev-inbound-secret

# ── Jobs ──────────────────────────────────────────────────────────────
JOB_CONCURRENCY=4
