# ── Core ──────────────────────────────────────────────────────────────
NODE_ENV=development
API_PORT=4100
PUBLIC_URL=http://localhost:4100
WEB_URL=http://localhost:5173

# Workspace resolution until Supabase auth lands: slug used when no API key provided
DEV_WORKSPACE_SLUG=harbor-ventures

# ── Postgres (local docker-compose) ───────────────────────────────────
DATABASE_URL=postgres://copyr:copyr@localhost:5433/copyr
# Optional transaction-mode pooler for the query pool only (never pg-boss):
# DATABASE_POOL_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
# DATABASE_SSL=auto
# DATABASE_POOL_MAX=10

# ── Storage (MinIO locally, Supabase Storage S3 API in prod) ──────────
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_REGION=us-east-1
STORAGE_BUCKET=copyr-local
STORAGE_ACCESS_KEY_ID=copyr-dev
STORAGE_SECRET_ACCESS_KEY=copyr-dev-secret
STORAGE_FORCE_PATH_STYLE=true

# ── AI ────────────────────────────────────────────────────────────────
# mock | openai  (mock = deterministic, offline, free)
AI_PROVIDER=mock
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_CREDITS_MONTHLY_GRANT=500

# ── Email ingestion ───────────────────────────────────────────────────
# Shared secret for inbound webhook (Mailpit → webhook / SES → webhook)
INBOUND_WEBHOOK_SECRET=dev-inbound-secret

# ── Jobs ──────────────────────────────────────────────────────────────
JOB_CONCURRENCY=4

# ── CORS / boot (production) ──────────────────────────────────────────
# CORS_ORIGINS=https://your-other-origin.example
# CORS_ALLOW_VERCEL_PREVIEWS=true
# AUTO_MIGRATE=false

# ── Production (venlabs-demo / Vercel web + long-running API) ─────────
# Copy these into the API host (Render/Fly/Railway) and Vercel — never commit secrets.
#
# DATABASE_URL=postgresql://postgres.cdsngnauduhiaidzncie:[DB-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres?sslmode=require
# DATABASE_POOL_URL=postgresql://postgres.cdsngnauduhiaidzncie:[DB-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require
# STORAGE_ENDPOINT=https://cdsngnauduhiaidzncie.storage.supabase.co/storage/v1/s3
# STORAGE_REGION=[PROJECT-REGION]
# STORAGE_BUCKET=copyr
# STORAGE_ACCESS_KEY_ID=[SUPABASE-S3-ACCESS-KEY]
# STORAGE_SECRET_ACCESS_KEY=[SUPABASE-S3-SECRET-KEY]
# STORAGE_FORCE_PATH_STYLE=true
# PUBLIC_URL=https://copyr-api.onrender.com
# WEB_URL=https://copyr.vercel.app
# CORS_ALLOW_VERCEL_PREVIEWS=true
# AUTO_MIGRATE=true
#
# Vercel (apps/web build-time):
# VITE_API_URL=https://copyr-api.onrender.com
# VITE_WORKSPACE_SLUG=harbor-ventures
