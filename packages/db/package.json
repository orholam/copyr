{
  "name": "@copyr/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema.ts",
    "./*": "./src/*.ts",
    "./*.js": "./src/*.ts"
  },
  "scripts": {
    "generate": "drizzle-kit generate",
    "migrate": "tsx src/scripts/migrate.ts",
    "seed": "tsx src/scripts/seed.ts",
    "studio": "drizzle-kit studio",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "test": "vitest run --passWithNoTests",
    "build": "tsc --noEmit"
  },
  "dependencies": {
    "@copyr/config": "workspace:*",
    "drizzle-orm": "^0.44.2",
    "fractional-indexing": "^4.0.0",
    "pg": "^8.16.0"
  },
  "devDependencies": {
    "@copyr/tsconfig": "workspace:*",
    "@types/pg": "^8.15.0",
    "drizzle-kit": "^0.31.4",
    "tsx": "^4.20.0",
    "typescript": "^5.8.3",
    "vitest": "^3.1.0"
  }
}
