# ── Copyr API (Fastify + workers) ────────────────────────────────────
FROM node:22-slim AS deps
RUN corepack enable
WORKDIR /repo
COPY pnpm-workspace.yaml package.json ./
COPY packages/config/package.json packages/config/
COPY packages/contracts/package.json packages/contracts/
COPY packages/tsconfig/package.json packages/tsconfig/
COPY packages/db/package.json packages/db/
COPY packages/storage/package.json packages/storage/
COPY packages/ai/package.json packages/ai/
COPY packages/core/package.json packages/core/
COPY apps/api/package.json apps/api/
COPY apps/mcp/package.json apps/mcp/
RUN pnpm install --frozen-lockfile=false

FROM node:22-slim AS build
RUN corepack enable
WORKDIR /repo
COPY --from=deps /repo ./
COPY tsconfig.base.json ./
COPY packages ./packages
COPY apps/api ./apps/api
COPY apps/mcp ./apps/mcp
ENV NODE_ENV=production
# source-run: typecheck as the build gate, run via tsx
RUN pnpm --filter @copyr/core --filter @copyr/api typecheck

FROM node:22-slim AS runtime
RUN corepack enable && apt-get update -qq && apt-get install -y -qq ca-certificates && rm -rf /var/lib/apt/lists/*
WORKDIR /repo
COPY --from=build /repo ./
ENV NODE_ENV=production
EXPOSE 4100
CMD ["pnpm", "--filter", "@copyr/api", "start"]
