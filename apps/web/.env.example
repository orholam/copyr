# Vercel build-time only (inlined by Vite). Do not put DATABASE_URL here.
# The Fastify API is a separate host — see docs/DEPLOY.md.

# Public API origin (Render/Fly/Railway). Leave empty for local Vite proxy.
VITE_API_URL=

# Optional: sent only with the Vite-dev auth bypass, or after /me selects a workspace.
VITE_WORKSPACE_SLUG=harbor-ventures

# venlabs-demo Auth (Dashboard → Project Settings → API).
# Use the project's current legacy anon JWT. Never put the service-role key here.
VITE_SUPABASE_URL=https://cdsngnauduhiaidzncie.supabase.co
VITE_SUPABASE_ANON_KEY=

# Local only: allow sign-in without Supabase (any password → /app) on `vite`.
# Must be the string "true". Ignored in `vite build` / Vercel production.
# VITE_DEV_AUTH=true
